{
  "name": "apollo-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that exposes Apollo.io API (search, enrich, sequences, lists, CRM) to AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
